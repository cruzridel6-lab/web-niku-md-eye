# IA local de NIKU MD: no necesita API ni clave externa.
# Antiporno local: MobileNetV2 viene incluido en nsfwjs
# NSFW_MODEL=MobileNetV2
# NSFW_PORN_THRESHOLD=0.45
# NSFW_SEXY_THRESHOLD=0.70

# ADMIN dashboard (configure these in Railway Variables)
ADMIN_USERNAME=admin*
ADMIN_PASSWORD=admin*1
# Opcional: también permite entrar usando el número del administrador.
# Escribe solo dígitos y código de país, sin espacios.
# ADMIN_NUMBER=18090000000

# Reportes de usuarios
# Si se omite REPORT_CHANNEL_JID, el bot resuelve WHATSAPP_CHANNEL_URL automáticamente.
# REPORT_CHANNEL_JID=120363xxxxxxxxxx@newsletter
# WHATSAPP_CHANNEL_URL=https://whatsapp.com/channel/tu_codigo
# TELEGRAM_CHANNEL_URL=https://t.me/Dark_Zone_666
# URL pública de la web; si Railway define RAILWAY_PUBLIC_DOMAIN se calcula automáticamente.
# WEB_URL=https://tu-dominio.example
# URL directa del panel admin; si se omite usa WEB_URL#admin.
# ADMIN_URL=https://tu-dominio.example#admin
# REPORT_TIMEZONE=America/New_York
# Zona horaria predeterminada para .horario (cada grupo puede cambiarla)
# GROUP_SCHEDULE_TIMEZONE=America/New_York

# Backup cifrado opcional en GitHub (no compartas estos valores)
# GITHUB_BACKUP_TOKEN=ghp_o_github_pat_con_contents_write
# GITHUB_BACKUP_REPO=cruzridel6-lab/web-niku-md-eye
# GITHUB_BACKUP_BRANCH=main
# GITHUB_BACKUP_PATH=data/persistent-state.enc
# BACKUP_ENCRYPTION_KEY=crea_una_clave_larga_y_unica

# Backup cifrado de datos, archivos subidos y sesiones WhatsApp en Telegram.
# Configura el token del bot creado con @BotFather en Railway.
# Añade el bot como administrador del canal con permiso para publicar y fijar.
# Publica /backupid en el canal y copia el ID que responda el bot a Railway.
# TELEGRAM_BOT_TOKEN=token_entregado_por_BotFather
# TELEGRAM_BACKUP_CHAT_ID=-1001234567890
# Genera una clave aleatoria para Railway: openssl rand -base64 32
# TELEGRAM_BACKUP_ENCRYPTION_KEY=clave_aleatoria_privada_de_32_bytes_o_mas
# Si ya usas GitHub Backup, TELEGRAM_BACKUP_ENCRYPTION_KEY puede omitirse y se
# reutilizará BACKUP_ENCRYPTION_KEY.
